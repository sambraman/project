# Copy to .env and edit:  cp .env.example .env
# Load into your shell (mac/Linux):  export $(grep -v '^#' .env | xargs)

# Tickers the nightly refresh pulls into the cache (comma-separated).
TRACKED_TICKERS=IVV,QQQ,SPY,VTI,VOO,SCHD

# Secret required by POST /refresh. Use any long random string.
REFRESH_TOKEN=change-me-to-a-long-random-string

# Frontend origin(s) allowed via CORS. Use * until you have a real URL.
ALLOWED_ORIGINS=*

# Serve everything from bundled fixtures instead of the live issuer sites.
# Great for a no-network demo or CI. Set to 1 to enable. Set 0 for real scraping.
OFFLINE=0

# OpenFIGI maps N-PORT holdings (CUSIP/ISIN) to tickers. Works without a key at a
# slow anonymous rate; a free key (https://www.openfigi.com/api) is strongly
# recommended so funds with hundreds of holdings enrich in seconds, not minutes.
# Leave blank to run keyless.
OPENFIGI_API_KEY=
