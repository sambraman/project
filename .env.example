# Copy to .env and edit:  cp .env.example .env
# Load into your shell (mac/Linux):  export $(grep -v '^#' .env | xargs)

# Tickers the nightly refresh pulls into the cache (comma-separated). This is
# also the default universe for the daily price job (refresh_prices.py).
TRACKED_TICKERS=IVV,QQQ,SPY,VTI,VOO,SCHD

# Price source for daily bars + valuation multiples. EODHD (licensable, one
# vendor) when set; yfinance dev fallback otherwise. Free tier is ~20 calls/day,
# so the price job defaults to TRACKED_TICKERS only. https://eodhd.com
EODHD_API_KEY=

# Secret required by POST /refresh. Use any long random string.
REFRESH_TOKEN=change-me-to-a-long-random-string

# Frontend origin(s) allowed via CORS. Use * until you have a real URL.
ALLOWED_ORIGINS=*

# Serve everything from bundled fixtures instead of the live issuer sites.
# Great for a no-network demo or CI. Set to 1 to enable. Set 0 for real scraping.
OFFLINE=0

# OpenFIGI maps N-PORT holdings (CUSIP/ISIN) to tickers. Works without a key at a
# slow anonymous rate; a free key (https://www.openfigi.com/api) is strongly
# recommended so funds with hundreds of holdings enrich in seconds, not minutes.
# Leave blank to run keyless.
OPENFIGI_API_KEY=

# Identify yourself to issuer sites. An issuer can then contact you instead of
# silently blocking your IP. Strongly recommended: an email or project URL.
HTTP_CONTACT=

# Per-host request budgets, "host=calls/seconds". Defaults are already
# conservative (iShares 8/60 against their 10/60 ceiling); override only to go
# SLOWER, or if an issuer grants you a higher allowance.
RATE_LIMITS=

# Hours to reuse a cached issuer product catalog before refetching (default 24).
# Higher = fewer requests against strict WAFs.
CATALOG_TTL_HOURS=24

# Where the unified datastore lives (lookthrough.db). On Render, point this at
# a MOUNTED PERSISTENT DISK — the default is ephemeral and the cache dies on
# every deploy, which is what makes cold requests slow.
DATA_DIR=./data
